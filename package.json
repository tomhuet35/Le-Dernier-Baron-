{
  "name": "le-dernier-baron",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Le Dernier Baron, jeu de cartes en ligne pour 3 à 6 joueurs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prebuild": "node organiser.mjs",
    "dev": "concurrently -k -n serveur,client \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/server.js --packages=external",
    "start": "node dist/server.js",
    "test": "vitest run",
    "verifier": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.24.2",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vite": "^5.4.21"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
